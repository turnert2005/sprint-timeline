# Marketplace publishing (scripts/publish.mjs).
# Mint at https://dev.azure.com -> user settings -> Personal access tokens.
# Scope: Marketplace > Publish, organization: All accessible organizations.
SPRINTTIMELINE_PUBLISH_PAT=

# Sandbox org automation (scripts/dev_org_setup.py) against a disposable
# test organization. Never use a production org token here.
SPRINTTIMELINE_DEV_PAT=
